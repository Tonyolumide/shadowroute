COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
DEPLOYER_PRIVATE_KEY=0xYOUR_COSTON2_TEST_KEY
TEE_SIGNER_ADDRESS=0xYOUR_TEE_SIGNER_ADDRESS
TEE_SIGNER_PRIVATE_KEY=0xYOUR_TEE_SIGNER_TEST_KEY
XRPL_TESTNET_RPC_URL=wss://s.altnet.rippletest.net:51233
XRPL_SEED=sYOUR_XRPL_TESTNET_SEED
FDC_VERIFIER_BASE_URL=https://fdc-verifiers-testnet.flare.network
FDC_VERIFIER_API_KEY=YOUR_FDC_VERIFIER_API_KEY
FDC_DA_LAYER_URL=https://ctn2-data-availability.flare.network
SHADOW_ROUTER_ADDRESS=0xYOUR_SHADOW_ROUTER
V2_EXCHANGE_ROUTER=0xYOUR_V2_ROUTER

# Required by the official FCC extension proxy; request read-only credentials from Flare support.
FCC_INDEXER_HOST=YOUR_INDEXER_HOST
FCC_INDEXER_PORT=3306
FCC_INDEXER_DATABASE=YOUR_INDEXER_DATABASE
FCC_INDEXER_USERNAME=YOUR_INDEXER_USERNAME
FCC_INDEXER_PASSWORD=YOUR_INDEXER_PASSWORD

# Public HTTPS tunnel to the extension proxy's local port 6674.
EXT_PROXY_URL=https://YOUR_STABLE_TUNNEL_HOST
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
